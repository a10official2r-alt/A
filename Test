    LoadingTitle = "Anghelo's Script Hub",
    LoadingSubtitle = "Version 0.1 TEST",
    
    ConfigurationSaving = {
        Enabled = false
    },

    KeySystem = false,

})

local Tab = Window:CreateTab("SAE (No key)", 4483362458)

Tab:CreateButton({
